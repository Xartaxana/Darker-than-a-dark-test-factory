# смертей ребёнка heartbeat (per-host операционное состояние, пишется/
# читается ТОЛЬКО heartbeat_wrap.py) — тот же класс, что
# heartbeat-budget.txt выше, не версионируем.
state/heartbeat-fastdeath.json
