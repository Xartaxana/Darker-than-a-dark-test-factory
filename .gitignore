# Разовые/временные файлы сессий (housekeeping-норма CLAUDE.md) — git-шум
# из scratchpad/ не версионируем (решение Lead, spec-dirty-tree-check
# 2026-08-20).
scratchpad/

# Портативный инструментарий и артефакты сборки — не версионируем
tools/
# staging-сдача гейтов из штаба (порт 07-16) — ВЕРСИОНИРУЕТСЯ:
# глобальный игнор tools/ молча выкинул её содержимое из первого
# коммита порта (класс «сборка сверяется диффом», урок t-155 штаба)
!staging_gates/tools/
app-under-test/
framework/.venv/
framework/allure-results/
# пер-стековый каталог результатов стека 2 (Use-DeviceStack -N 2,
# ALLURE_RESULTS=framework/allure-results-2) — тот же класс, что allure-results/
framework/allure-results-2/
framework/allure-report/
framework/**/__pycache__/
**/__pycache__/
*.pyc

# spec-p2-pyramid-bridge N5 (docs/tasks/p2-pyramid-bridge.md Р3, B1): дом
# bridge-harness (framework/bridge_harness/) ВЕРСИОНИРУЕТСЯ (package.json +
# package-lock.json коммитятся, в отличие от tools/ — класс t-155), только
# node_modules/ не версионируется. Bare-паттерн (не полный путь) — матчит на
# ЛЮБОЙ глубине по семантике .gitignore, дом здесь: N4 от этой строки
# отказался (r3-блокер 1), дом — N5.
node_modules/

# Временные результаты прогонов (Allure/скриншоты); сами отчёты runs/*.md версионируем
framework/**/.pytest_cache/

# board/ — генерируемая проекция (источник правды: test-cases/, bugs/, runs/).
